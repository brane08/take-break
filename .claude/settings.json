{
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit(**/*.java)",
      "Edit(**/*.fxml)",
      "Edit(**/*.xml)",
      "Edit(**/*.properties)",
      "Edit(**/*.json)",
      "Edit(**/*.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/memory/*.md)",
      "Bash(git *)",
      "Bash(java *)",
      "Bash(javac *)",
      "Bash(mvn compile *)",
      "Bash(mvn test *)",
      "Bash(mvn verify *)",
      "Bash(mvn package *)",
      "Bash(mvn -q *)",
      "Bash(mvn -f *)",
      "Bash(mvn -Dtest=*)",
      "Bash(mvn -pl *)",
      "Bash(mvn dependency:tree *)",
      "Bash(mvn dependency:sources *)",
      "Bash(mvn dependency:resolve *)",
      "Bash(mvn help:effective-pom *)",
      "Bash(mvn javafx:run *)",
      "Bash(jar tf *)",
      "Bash(unzip -p *)",
      "Bash(find . *)",
      "Bash(grep *)",
      "Bash(less *)",
      "Bash(awk *)"
    ],
    "ask": [
      "Bash(mvn install *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(rmdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(dd *)",
      "Bash(sudo *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(mkfs*)",
      "Bash(format *)",
      "Read(./.env*)",
      "Read(/**/*.env)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.p12)"
    ]
  }
}
