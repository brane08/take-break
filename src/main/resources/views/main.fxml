<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
	  xmlns:fx="http://javafx.com/fxml"
	  fx:controller="com.github.brane08.fx.takebreak.controllers.BreakController"
	  fx:id="rootPane" style="-fx-background-color: #2d2d40; -fx-font-size: 16px;">
	<padding>
		<Insets top="20" right="20" bottom="20" left="20"/>
	</padding>
	<Label alignment="CENTER" style="-fx-font-size: 2em; -fx-text-fill: azure;" text="Your break ends in!!!"
		   textAlignment="CENTER"/>
	<HBox spacing="20.0" alignment="CENTER">
		<padding>
			<Insets top="20" right="20" bottom="20" left="20"/>
		</padding>
		<VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="8"
			  style="-fx-background-color: #1a1a2a; -fx-background-radius: 8; -fx-padding: 15;">
			<Label text="Minutes Remaining" style="-fx-text-fill: #8888aa; -fx-font-size: 0.85em;"/>
			<Label fx:id="minutes" text="00" style="-fx-text-fill: white; -fx-font-size: 6em; -fx-font-weight: bold;"/>
		</VBox>
		<VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="8"
			  style="-fx-background-color: #1a1a2a; -fx-background-radius: 8; -fx-padding: 15;">
			<Label text="Seconds Remaining" style="-fx-text-fill: #8888aa; -fx-font-size: 0.85em;"/>
			<Label fx:id="seconds" text="00" style="-fx-text-fill: white; -fx-font-size: 6em; -fx-font-weight: bold;"/>
		</VBox>
	</HBox>
	<HBox spacing="20.0" alignment="CENTER">
		<padding>
			<Insets top="20" right="20" bottom="20" left="20"/>
		</padding>
		<Button text="Skip Break!" fx:id="btnSkip" onAction="#stopTimer" style="-fx-font-size: 1.1em;"/>
	</HBox>
</VBox>
